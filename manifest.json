{
  "manifest_version": 3,
  "name": "Dark Shield - No Data",
  "version": "1.0.1",
  "description": "Transforms high-brightness sites to dark. No data collection. Whitelist/Blacklist modes.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dark.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dark Shield"
  },
  "options_page": "options.html"
}